<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#252732"/>
            <stroke android:width="1dp" android:color="#363A4B"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#14151C"/>
            <stroke android:width="1dp" android:color="#232530"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
