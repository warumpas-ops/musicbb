<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#262934"/>
            <stroke android:width="1dp" android:color="#3B4052"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#14151B"/>
            <stroke android:width="1dp" android:color="#232530"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
