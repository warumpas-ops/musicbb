<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — MusicBB Premium Hi-Fi Interface for BlackBerry Q5 (720x720) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Status & Header Bar (32dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="#070709">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MUSICBB"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvTrackBitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEREO AUDIO"
            android:textColor="@color/text_muted"
            android:textSize="9sp"
            android:background="@drawable/badge_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"/>

    <!-- MAIN CONTENT FRAME -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== TAB 1: NOW PLAYING ==================== -->
        <LinearLayout
            android:id="@+id/tabNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <!-- Hero Permanent Album Artwork Frame -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/cover_border"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ivCoverArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </FrameLayout>

            <!-- Song Title and Artist -->
            <TextView
                android:id="@+id/tvTrackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Track Selected"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tvTrackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a song from tracks"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <!-- Progress Scrubber & Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvCurrTime"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:gravity="left"/>

                <SeekBar
                    android:id="@+id/sbProgress"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/seek_progress"
                    android:thumb="@drawable/seek_thumb"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"/>

                <TextView
                    android:id="@+id/tvTotTime"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:gravity="right"/>
            </LinearLayout>

            <!-- Primary Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnShuffle"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:text="⇄"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:background="@drawable/control_pill_selector"/>

                <TextView
                    android:id="@+id/btnPrev"
                    android:layout_width="48dp"
                    android:layout_height="34dp"
                    android:text="⏮"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:background="@drawable/control_pill_selector"
                    android:layout_marginLeft="10dp"/>

                <TextView
                    android:id="@+id/btnPlay"
                    android:layout_width="68dp"
                    android:layout_height="36dp"
                    android:text="▶"
                    android:textColor="#0A0A0C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/btn_play_bg"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"/>

                <TextView
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="34dp"
                    android:text="⏭"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:background="@drawable/control_pill_selector"
                    android:layout_marginRight="10dp"/>

                <TextView
                    android:id="@+id/btnRepeat"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:text="↻"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:background="@drawable/control_pill_selector"/>
            </LinearLayout>

            <!-- Bottom Sub-Actions: Favorite & Add to Playlist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnFav"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="☆ FAVORITE"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"/>

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp"/>

                <TextView
                    android:id="@+id/btnAddPlaylist"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="+ PLAYLIST"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ==================== TAB 2: TRACKS / LIBRARY ==================== -->
        <LinearLayout
            android:id="@+id/tabFolders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Search and Scan Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:background="#0D0E13">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="11sp"
                    android:hint="Search tracks... [F]"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/btnScanMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="SCAN"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/badge_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="#090A0D">

                <TextView
                    android:id="@+id/tvDirBreadcrumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ALL SONGS"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:singleLine="true"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_dark"/>

            <!-- Song List -->
            <ListView
                android:id="@+id/lvLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/row_selector"/>

            <TextView
                android:id="@+id/tvEmptyLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="No music found.\nTap SCAN to index your device."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ==================== TAB 3: PLAYLISTS ==================== -->
        <LinearLayout
            android:id="@+id/tabPlaylists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="#0D0E13">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PLAYLISTS"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnNewPlaylist"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="+ NEW PLAYLIST"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/badge_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_dark"/>

            <ListView
                android:id="@+id/lvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/row_selector"/>
        </LinearLayout>

        <!-- ==================== TAB 4: STATS & ANALYTICS ==================== -->
        <LinearLayout
            android:id="@+id/tabStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Plays Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/cover_border"
                    android:padding="10dp"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL PLAYS"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"/>

                    <TextView
                        android:id="@+id/tvStatTotalPlays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Listening Time Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/cover_border"
                    android:padding="10dp"
                    android:layout_marginLeft="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOURS STREAMED"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"/>

                    <TextView
                        android:id="@+id/tvStatTotalHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0h"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOST PLAYED TRACKS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <ListView
                android:id="@+id/lvTopTracks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_subtle"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/row_selector"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"/>

    <!-- Bottom Navigation Bar (38dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#070709">

        <TextView
            android:id="@+id/btnTabNow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PLAYER"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/tab_selected_bg"/>

        <TextView
            android:id="@+id/btnTabFolders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="TRACKS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/row_selector"/>

        <TextView
            android:id="@+id/btnTabPlaylists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PLAYLISTS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/row_selector"/>

        <TextView
            android:id="@+id/btnTabStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="STATS"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/row_selector"/>
    </LinearLayout>

</LinearLayout>
